# Copy to `secrets.env` (gitignored). Loaded by `npm run dev` / `npm run build`.
#
# Mail and dispatch credentials live in `.secrets/` (see README).

# Optional SMTP env overrides (used when ZOHO_APP_PASSWORD is set)
# ZOHO_SMTP_HOST=smtp.zoho.eu
# ZOHO_SMTP_USER=hello@rense.se
# ZOHO_APP_PASSWORD=

# STRIPE_SECRET_KEY=   # optional; overrides .secrets/stripe.json secretKey
# DISPATCH_KEY=        # optional; overrides .secrets/dispatch.json key (use on Vercel)

# DATABASE_URL=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
